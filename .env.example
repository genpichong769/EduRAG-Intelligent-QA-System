# LLM
DASHSCOPE_API_KEY=your_api_key_here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3-max

# MySQL (also consumed by docker/mysql/docker-compose.yml)
MYSQL_HOST=localhost
MYSQL_USER=edurag
MYSQL_PASSWORD=your_password_here
MYSQL_ROOT_PASSWORD=your_password_here
MYSQL_DATABASE=subjects_kg

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_DATABASE_NAME=itcast
MILVUS_COLLECTION_NAME=edurag_final

# MinIO used by the local Milvus stack
MINIO_ACCESS_KEY=your_api_key_here
MINIO_SECRET_KEY=your_password_here

# Optional local overrides
# BGE_M3_PATH=rag_qa/models/bge-m3
# BGE_RERANKER_PATH=rag_qa/models/bge-reranker-large
# QUERY_CLASSIFIER_MODEL_PATH=rag_qa/core/bert_query_classifier
# LOG_FILE=logs/app.log
